# Authenticated SMTP connection
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Use true for implicit TLS providers, commonly on port 465.
# Leave false for STARTTLS, commonly on port 587.
SMTP_USE_SSL=false

# Must be a verified sender on the authenticated domain.
SMTP_FROM_EMAIL=aditya@example.com
SMTP_FROM_NAME=Aditya

# The only URL included in the recipient email.
CONFIRMATION_URL=https://example.com/your-request
